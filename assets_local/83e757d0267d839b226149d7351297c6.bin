ating":100,"bundleId":"com.gymnotize"}}},{"$kind":"Lockup","adamId":"1548289459","bundleId":"eaten.eu.eaten","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0,"green":0,"blue":0,"type":"rgb"},"textColor":{"red":0.9803921568627451,"green":0.9803921568627451,"blue":0.9803921568627451,"type":"rgb"},"style":"roundedRectPrerendered","crop":"ia","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/d9/24/44/d92444be-207e-2226-6a2f-0b7e27a75e3c/AppIcon-0-0-1x_U007epad-0-11-0-sRGB-85-220.png/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Elite Food Diary Eat Mindfully","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Your food journal food tracker","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Your food journal food tracker","ageRating":"4+","productDescription":"Introducing Elite, Your Simple and Beautiful Food Diary\n\nWelcome to Elite, the simplest and most visually stunning food diary app you'll ever need. With its fluid and captivating layout, Elite keeps you at the forefront of your daily meals and effortlessly syncs data from HealthKit, including steps, sleep, and calorie burn.\n\nStay Present, Focus on Today:\nElite empowers you to focus on the present moment. Embrace each day as a new journey towards a better you, and let Elite be your trusted companion to track your entire day's meals in one convenient place.\n\nSeamless Glances at Your Progress:\nGet a comprehensive overview of your day on Elite Home View, where your meals and valuable HealthKit data blend seamlessly. Witness your progress in a glance, all presented with elegance and simplicity.\n\nDelve into Your History:\nWith Elite's History View, you can effortlessly explore your past meals and activities. Its functional layout offers both power and beauty, providing you with a complete perspective on your wellness journey.\n\nCollect Points, Unlock Achievements:\nElite introduces a unique points system that adds an element of gamification to your food tracking experience. Collect points as you make mindful choices and unlock achievements that celebrate your progress.\n\nShare and Motivate:\nConnect with friends on Elite, sharing your meals and inspiring each other on your wellness journeys. Together, you can create a supportive community that celebrates healthy choices and encourages personal growth.\n\nElevate your food tracking experience with Elite, where simplicity meets beauty, and each meal becomes a cherished moment of self-care and self-discovery.\n\nDownload Elite Food Diary today and embark on a new path towards a healthier, more mindful you.\nAll Features required additional purchase. To use app you need choose subscription 9.99$ monthly or 39.99$ yearly.\n\n\n\nTerms: https://eaten.flycricket.io/terms.html\nPrivacy Policy: https://eaten.flycricket.io/privacy.html","rating":4.6,"ratingCount":"75","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1548289459&pricingParameters=STDQ&pg=default&appExtVrsId=875261754"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1548289459"},{"locationPosition":4,"locationType":"lockup","name":"Elite Food Diary Eat Mindfully","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1548289459"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1548289459","eventType":"click","targetType":"button","targetId":"1548289459","platf