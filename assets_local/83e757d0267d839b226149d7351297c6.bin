mer","similarItems","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","product_media_watch_","description","editorialQuote","editorsChoice","productRatings","allProductReviews","allProductReviewActions","productReviewsFooter","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper"],"downloadingOrdering_Compact":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItems","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","userProductReviews","editorsChoiceProductReviews","productReviewsFooter","tapToRateProductReviewAction","writeAReviewProductReviewAction","tapToRateProductReviewAction","userProductReviews","editorsChoiceProductReviews","writeAReviewProductReviewAction","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper"],"downloadingOrdering_ExpandedMedia_Compact":["header","topLockup","informationRibbon","productPageInlineMessage","preorderDisclaimer","similarItems","bundleChildren","bundleParents","appEvents","mostRecentVersion","subscriptions","inAppPurchases","achievements","friendsPlaying","videos","product_media_phone_","product_media_watch_","description","editorialQuote","editorsChoice","productRatings","reviewSummary","userProductReviews","editorsChoiceProductReviews","productReviewsFooter","tapToRateProductReviewAction","writeAReviewProductReviewAction","tapToRateProductReviewAction","userProductReviews","editorsChoiceProductReviews","writeAReviewProductReviewAction","privacyHeader","privacyTypes","privacyFooter","accessibilityHeader","accessibilityFeatures","accessibilityDeveloperLink","information","purchasedLinks","capabilities","featuredIn","moreByDeveloper"]},"shelfMapping":{"topLockup":{"$kind":"Shelf","impressionMetrics":null,"contentType":"marker","marker":"productTopLockup","items":[],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"topLockup"},"description":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"0","name":"","impressionType":"description","idType":"sequential","impressionIndex":0}},"contentType":"productDescription","marker":null,"items":[{"$kind":"ProductDescription","paragraph":{"$kind":"Paragraph","text":"Stop guessing your next workout. Fitonist is the AI gym workout tracker that builds personalized training plans, logs every set and rep, and adapts each session to the progress you actually make.\n\nRated 4.8/5 by lifters and powered by AI that learns how you train, Fitonist turns a library of exercises into a focused plan that moves you toward your goal—faster.\n\nSMARTER WORKOUTS, BUILT BY AI\nTell us your goals and preferences, and our AI generates balanced, non-repetitive workouts made for you. Swap any exercise, build a superset, or adjust on the fly—and the AI automatically tunes your next session with the best-matching moves. No two workouts are the same, and every one is built to push you forward.\n\n600+ EXERCISES, REVIEWED BY COACHES\nExplore over 600 exercises for every level, each reviewed by professional coaches. Filter by muscle group, search instantly, and save your favorites. Clear video instructions and detailed cues help you perfect your technique on every rep.\n\nTRACK EVERY SET, REP & PR\nLogging is effortless. Record your weights and reps in seconds, see your full history for any exercise, and follow smart recommendations to beat your last session. Watch your personal records stack up over time.\n\nSEE YOUR PROGRESS, STAY MOTIVATED\nAnalyze your weekly goals on clean stats graphs, track calories burned per workout, and make sure every week beats the last. Fitonist syncs with the Health app to keep your data in one place.\n\nWHY LIFTERS CHOOSE FITONIST\n• AI-generated workouts that adapt to your progress\n• 600+ coach-reviewed exercises with video guides\n• Fast set, rep & weight logging with full history\n• Supersets, exercise swaps & full workout control\n• Weekly stats, calorie tracking & Health app sync\n• Built for the gym or home, dumbbells or barbell\n\nWhether you're chasing strength, muscle, or a routine that finally sticks, Fitonist gives you a smarter plan and the tracking to back it up.\n\nDownload Fitonist free and start training smarter today. Upgrade to Premium anytime for unlimited AI workouts and full progress insights.\n\nTerms of Use (EULA): https://fitonist.com/terms.html\nPrivacy Policy: https://fitonist.com/privacy.html","mediaType":"text/plain","style":"standard","alignment":"localized","isCollapsed":true,"suppressVerticalMargins":false,"wantsCollapsedNewlines":true},"developerAction":{"title":"Dmytro Demianchuk","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/developer/dmytro-demianchuk/id1617672408","location":[{"locationPosition":0,"locationType":"button","name":"Dmytro Demianchuk","idType":"its_id","id":"1617672408"}],"eventType":"click","targetType":"button","targetId":"1617672408","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFiel