036fd7b0b3/1097466/upload-23a69b40-7b0e-11e8-9b82-31e02007f855.jpg","url":"img/5b351f26c5d7c2036fd7b0b3/1097466/upload-23a67430-7b0e-11e8-9b82-31e02007f855.jpg","num":9}],"name":"","viewport_phone_portrait":{"images_h":213,"captions_h":0,"x":0,"y":913,"w":320,"h":213,"z":312},"version":2,"current_mode":"default","play_method":"click","transition_type":"slider","left_arrow_noun":{"rasterUrl":"https://d3n32ilufxuvd1.cloudfront.net/5699789733200e9422fbb08d/5b35202162a982707ff426f1/RasterizedImage-b407d854-aecb-45fb-92ef-39f8825fb05d.png","raster2xUrl":"https://d3n32ilufxuvd1.cloudfront.net/5699789733200e9422fbb08d/5b35202162a982707ff426f1/RasterizedImage-97bf960d-9c05-4e15-aa30-e9777bce64ce.png","raster3xUrl":"https://d3n32ilufxuvd1.cloudfront.net/5699789733200e9422fbb08d/5b35202162a982707ff426f1/RasterizedImage-534c9c3b-72c1-42d7-9a85-2f13fe8e3b54.png"},"right_arrow_noun":{"rasterUrl":"https://d3n32ilufxuvd1.cloudfront.net/5699789733200e9422fbb08d/5b35202162a982707ff426f1/RasterizedImage-8977e983-0720-4371-a86c-d65f3e5f22af.png","raster2xUrl":"https://d3n32ilufxuvd1.cloudfront.net/5699789733200e9422fbb08d/5b35202162a982707ff426f1/RasterizedImage-b0a6c0fd-2f16-4fef-8ac7-e43e74ad3dce.png","raster3xUrl":"https://d3n32ilufxuvd1.cloudfront.net/5699789733200e9422fbb08d/5b35202162a982707ff426f1/RasterizedImage-f5f83f8d-5bba-41d4-99ee-d5292fcda957.png"},"wid":"5b353e315fffd527036502c3","mag_num_id":1097466,"__v":0},{"_id":"65a94f17c70e2d004b90e700","x":110,"y":1427,"w":333,"h":431,"type":"text","version":3,"verticalAlign":"top","textDirection":"LTR","autosize":true,"blocks":[{"key":"fh702","text":"Groups","entityRanges":[],"depth":0},{"key":"bcdmu","text":"For groups, we offer a hands-on lecture-based workshop. We accept 2-hour appointments on Fridays, during which we close down the Center just for you and work to tailor the program to your interests. Our interactive session provides a deep dive into the work of Herb Lubalin and other practitioners, and highlights ways that designers can actively use design history in their day-to-day practice.  ","entityRanges":[],"depth":0},{"key":"360b6","text":"‍","entityRanges":[],"depth":0},{"key":"ced2b","text":"Corporate group visit rates: ","entityRanges":[],"depth":0},{"key":"7khq4","text":"Up to 6 people: $350 ","entityRanges":[],"depth":0},{"key":"bngug","text":"7-20 people: $400+ upon consultation","entityRanges":[],"depth":0},{"key":"28j08","text":"","entityRanges":[],"depth":0},{"key":"517ne","text":"Educational groups:","entityRanges":[],"depth":0},{"key":"causn","text":"Fees are waived  ","entityRanges":[],"depth":0},{"key":"9bmvd","text":"Get in touch with us if your class falls not on a Friday and we will try our best to accommodate.   ","entityRanges":[],"depth":0},{"key":"3mepj","text":"‍","entityRanges":[],"depth":0},{"key":"fnno1","text":"We are a non-profit with all fees going directly to The Cooper Union which allows us to offer free visits to all students.   ","entityRanges":[],"depth":0},{"key":"cdl21","text":"‍","entityRanges":[],"depth":0},{"key":"65j4","text":"For more information, or to schedule a visit, \nplease email (lubalin@cooper.edu) or call 212.353.4021.","entityRanges":[],"depth":0}],"styles":[{"key":"fh702","type":"unstyled","inlineStyles":{"styles":[{"offset":0,"length":6,"styles":["0;0","1;1","2;2","3;3","4;4","5;4","6;5"]}],"keys":["FONT_SIZE","FONT_WEIGHT","FONT_FAMILY","FONT_STYLE","DECORATION","TRANSFORM","COLOR"],"values":["13","700","Graphik","normal","none","00000064"]}},{"key":"bcdmu","type":"unstyled","inlineStyles":{"styles":[{"offset":0,"length":397,"styles":["0;0","2;2","3;3","4;4","5;4","6;5"]},{"offset":0,"length":66,"styles":["1;1"]},{"offset":85,"length":4,"styles":["1;1"]},{"offset":96,"length":301,"styles":["1;1"]},{"offset":66,"length":19,"styles":["1;6"]},{"offset":89,"length":7,"styles":["1;6"]}],"keys":["FONT_SIZE","FONT_WEIGHT","FONT_FAMILY","FONT_STYLE","DECORATION","TRANSFORM","COLOR"],"values":["13","400","Graphik","normal","none","0000