						ads.forEach(ad => {
							setTimeout(() => {
								if (ad.parentElement && ad.parentElement.offsetWidth > 0) {
									try {
										(window.adsbygoogle = window.adsbygoogle || []).push({});
									} catch (e) {
										console.error("AdSense Error:", e);
