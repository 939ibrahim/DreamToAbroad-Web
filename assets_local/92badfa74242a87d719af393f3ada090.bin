.font-switcher-overlay[data-astro-cid-h5yfrdtr].hidden{opacity:0;pointer-events:none;transform:scale(1.05)}.font-switcher-modal[data-astro-cid-h5yfrdtr]{background:var(--bg-color);border:1px solid var(--border-color);padding:40px;max-width:800px;width:90%;border-radius:8px;box-shadow:0 20px 40px #0006}h3[data-astro-cid-h5yfrdtr]{font-family:var(--font-secondary);font-size:24px;margin-bottom:8px;text-transform:uppercase;letter-spacing:2px}.hint[data-astro-cid-h5yfrdtr]{font-size:11px;opacity:.5;margin-bottom:32px;text-transform:uppercase}.hint[data-astro-cid-h5yfrdtr] span[data-astro-cid-h5yfrdtr]{border:1px solid var(--border-color);padding:2px 6px;border-radius:4px}.switcher-sections[data-astro-cid-h5yfrdtr]{display:grid;grid-template-columns:1fr 1fr 1fr;gap:32px}h4[data-astro-cid-h5yfrdtr]{font-size:10px;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;opacity:.7}.font-options[data-astro-cid-h5yfrdtr]{display:flex;flex-direction:column;gap:8px}button[data-astro-cid-h5yfrdtr]{background:transparent;border:1px solid var(--border-color);color:var(--text-color);padding:10px;text-align:left;cursor:pointer;font-size:11px;transition:all .2s ease;border-radius:4px;text-transform:uppercase;letter-spacing:.5px}button[data-astro-cid-h5yfrdtr]:hover{background:var(--background-secondary)}button[data-astro-cid-h5yfrdtr].active{background:var(--text-color);color:var(--bg-color);border-color:var(--text-color)}.bricolage-controls[data-astro-cid-h5yfrdtr]{margin-top:32px;padding-top:32px;border-top:1px solid var(--border-color)}input[data-astro-cid-h5yfrdtr][type=range]{width:100%;accent-color:var(--text-color)}.hidden[data-astro-cid-h5yfrdtr]{display:none}@keyframes astroFadeInOut{0%{opacity:1}to{opacity:0}}@keyframes astroFadeIn{0%{opacity:0;mix-blend-mode:plus-lighter}to{opacity:1;mix-blend-mode:plus-lighter}}@keyframes astroFadeOut{0%{opacity:1;mix-blend-mode:plus-lighter}to{opacity:0;mix-blend-mode:plus-lighter}}@keyframes astroSlideFromRight{0%{transform:translate(100%)}}@keyframes astroSlideFromLeft{0%{transform:translate(-100%)}}@keyframes astroSlideToRight{to{transform:translate(100%)}}@keyframes astroSlideToLeft{to{transform:translate(-100%)}}@media(prefers-reduced-motion){::view-transition-group(*),::view-transition-old(*),::view-transition-new(*){animation:none!important}[data-astro-transition-scope]{animation:none!important}}
