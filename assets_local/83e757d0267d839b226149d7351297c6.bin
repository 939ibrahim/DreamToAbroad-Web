productVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=top-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1548289459","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1548289459","name":"Elite Food Diary Eat Mindfully","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":4,"contentRating":100,"bundleId":"eaten.eu.eaten"}}},{"$kind":"Lockup","adamId":"1523992725","bundleId":"org.instaquit.app","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.30196078431372547,"green":0.49411764705882355,"blue":0.5568627450980392,"type":"rgb"},"textColor":{"red":0.011764705882352941,"green":0.023529411764705882,"blue":0.027450980392156862,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/30/07/a2/3007a24c-b38e-12fb-452d-6d025b3fba55/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"QuitSure Quit Smoking & Vaping","isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"subtitle":"Clinically proven. 81% success","tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Clinically proven. 81% success","ageRating":"18+","productDescription":"A modern, enjoyable and no-guilt approach to quit smoking.\n\nQuit smoking the easiest way. QuitSure offers 6-day and 6-week programs that removes your desire to smoke - so you quit without cravings, without withdrawal, and without willpower.\n\nYou don't have to quit today. You can keep smoking during the entire program and quit only when you're truly ready. No guilt. No pressure.\n\n96% of quit attempts fail - not because you lack willpower, but because most methods fight the wrong battle. QuitSure doesn't ask you to resist cravings. It eliminates them. By the time you reach your quit day, you won't want to smoke anymore.\n\n -  -  - \n\nWHY QUITSURE WORKS\n\nQuitSure is built on the science of why you smoke - and uses that science to undo the addiction at its root.\n\n◆ Based on Cognitive Behavioral Therapy (CBT), REBT Therapy, and Classical Conditioning\n◆ Grounded in principles of psychology, neuroscience, and habit formation\n◆ Personalised to your specific smoking triggers\n◆ Created by ex-smokers who truly understand what you're going through\n\nNo lifestyle overhaul. No self-control battles. No guilt trips. Just a clear, step-by-step path to becoming smoke-free.\n\n -  -  - \n\nHOW THE PROGRAM WORKS\n\nThe QuitSure program takes about one hour per day over 6 days - roughly 8 to 10 hours total. Each day, you'll read, watch, and listen to content designed to change how your mind thinks about smoking.\n\n◆ Personalised daily sessions tailored to your triggers\n◆ Short mental exercises each day (5 to 20 minutes) that dissolve cravings at the source\n◆ Step-by-step instructions - just follow the program\n◆ Learn why other quit methods fail and why this one doesn't\n◆ Understand how nicotine addiction actually works\n◆ Prepare for your quit day with proven relapse-prevention tools\n\nYou set the pace. The program guides you. And when your quit day arrives, you'll be ready - not because you're forcing yourself, but because the desire is gone.\n\n -  -  - \n\nWHAT YOU GET\n\n◆ A complete 6-day quit smoking program\n◆ A personal coach to support you\n◆ Daily video, audio, and reading content\n◆ Quick daily exercises to rewire your cravings\n◆ A quit smoking tracker for cigarettes, progress, and milestones\n◆ Techniques and tools to stay smoke-free after you quit\n◆ A supportive community of people on the same journey\n◆ Motivational content and daily notifications to keep you on track\n\n -  -  - \n\nWHAT CHANGES WHEN YOU QUIT\n\nQuitting smoking transforms every part of your life - and it starts sooner than you think.\n\n◆ No more cravings or withdrawal symptoms\n◆ More energy, better sleep, and improved focus\n◆ Better sense of taste and smell\n◆ Whiter teeth and no lingering smoke odour\n◆ More money in your pocket every single week\n◆ Greater self-confidence and self-respect\n◆ Improved mood and productivity\n\n -  -  - \n\nWHO IS QUITSURE FOR\n\nQuitSure is for anyone who smokes or vapes and wants to stop - whether you've tried to quit before or this is your first attempt. If past methods haven't worked, that's not a reflection of your willpower. It means you haven't found the right approach yet.\n\n -  -  - \n\n\nTHE BEST TIME TO TAKE THE FIRST STEP IS TODAY.\n\n\nQuitsure offers a 3-day free trial, after which a paid subscription is required to continue access. Subscription prices may vary by country and will be displayed clearly within the app before purchase, with charges converted to your local currency. Payment will be charged to your iTunes account at confirmation of purchase. Subscriptions automatically renew unless auto-renew is turned off at least 24 hours before the end of the current billing period. Your account will be charged for renewal within 24 hours prior to the end of the current period. You can manage or cancel your subscription at any time through your iTunes Account Settings.\n\nTerms of Use: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/","rating":4.8,"ratingCount":"1.5K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco