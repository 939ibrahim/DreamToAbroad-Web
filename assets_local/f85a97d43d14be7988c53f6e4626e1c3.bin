ff317-950x1500-jpg\",\"_type\":\"reference\"}},{\"_key\":\"8f439fdda5bd\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-44bba3b6ced1481e92ac7a73073e6a469ea46372-952x1500-jpg\",\"_type\":\"reference\"}},{\"_key\":\"a55c52c2c217\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-330ec484bb5264ea006b188cbbc2ec5f2961ba1d-950x1500-jpg\",\"_type\":\"reference\"}}],\"notes\":[{\"_key\":\"ef20ec2e586d\",\"_type\":\"block\",\"children\":[{\"_key\":\"983c58199536\",\"_type\":\"span\",\"marks\":[\"a8f7916b650a\"],\"text\":\"Nick Hornby on the original cover of \"},{\"_key\":\"5cfd2d3556fc\",\"_type\":\"span\",\"marks\":[\"em\",\"a8f7916b650a\"],\"text\":\"Excession\"},{\"_key\":\"f73a6eb1db4d\",\"_type\":\"span\",\"marks\":[],\"text\":\":\"}],\"markDefs\":[{\"_key\":\"a8f7916b650a\",\"_type\":\"link\",\"href\":\"https://www.thebeliever.net/stuff-ive-been-reading-19/\"}],\"style\":\"normal\"},{\"_key\":\"f758bed9d762\",\"_type\":\"block\",\"children\":[{\"_key\":\"d3aa8fdfa377\",\"_type\":\"span\",\"marks\":[],\"text\":\"Even buying Iain M. Banks’s \"},{\"_key\":\"29d12e714624\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Excession\"},{\"_key\":\"6168d16c8b77\",\"_type\":\"span\",\"marks\":[],\"text\":\" was excruciating. Queuing up behind me at the cash desk was a very attractive young woman clutching some kind of groovy art magazine, and I felt obscurely compelled to tell her that the reason I was buying this purple book with a spacecraft on the cover was because of the \"},{\"_key\":\"5f2b42b561a6\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Believer,\"},{\"_key\":\"fbcd436a2841\",\"_type\":\"span\",\"marks\":[],\"text\":\" and the \"},{\"_key\":\"35bdbbc2c01e\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"Believer\"},{\"_key\":\"1f3ba3b410f1\",\"_type\":\"span\",\"marks\":[],\"text\":\" was every bit as groovy as her art magazine. In a rare moment of maturity, however, I resisted the compulsion. She could, I decided, think whatever the hell she wanted. It wasn’t a relationship that was ever going to go anywhere anyway.\"}],\"markDefs\":[],\"style\":\"blockquote\"},{\"_key\":\"3e6a8521a531\",\"_type\":\"block\",\"children\":[{\"_key\":\"b08a2ecd6491\",\"_type\":\"span\",\"marks\":[],\"text\":\"Go off, dude.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"publisher\":\"Orbit Books\",\"slug\":{\"_type\":\"slug\",\"current\":\"the-culture\"},\"title\":\"The Culture\"},\"className\":\"\"}]\n"])</script><script>self.__next_f.push([1,"27:[\"$\",\"$L25\",\"legacy-book-5273\",{\"book\":{\"_createdAt\":\"2021-07-28T18:15:50Z\",\"_id\":\"legacy-book-5273\",\"_rev\":\"m6nSyVU6lqC08JIvickeyx\",\"_system\":{\"base\":{\"id\":\"legacy-book-5273\",\"rev\":\"Hwav73AlXmAgdoOroxE0mF\"}},\"_type\":\"book\",\"_updatedAt\":\"2025-10-17T17:38:43Z\",\"authors\":[{\"name\":\"Tamara Shopsin\"}],\"cover\":{\"_key\":\"6f2f2547-0a77-4c31-b38d-0d138a2e4a7b\",\"_type\":\"image\",\"asset\":{\"metadata\":{\"blurHash\":\"dBQT4M_3_3WB~q4n4n-;4nD%fP%NoeIUD%ay00xu%MRj\",\"dimensions\":{\"_type\":\"sanity.imageDimensions\",\"aspectRatio\":0.667,\"height\":1000,\"width\":667},\"lqip\":\"data:image/jpeg;base64,\"},\"originalFilename\":\"662a3e4a13cb6eea1862a0560698ae63cbdc29e0-667x1000.jpg\",\"url\":\"https://cdn.sanity.io/images/ps8jihhe/production/662a3e4a13cb6eea1862a0560698ae63cbdc29e0-667x1000.jpg\"}},\"datePublished\":\"2021-07-28T18:15:50\",\"designers\":[{\"name\":\"Tamara Shopsin\"}],\"genre\":\"fiction\",\"images\":[{\"_key\":\"6f2f2547-0a77-4c31-b38d-0d138a2e4a7b\",\"_type\":\"image\",\"asset\":{\"_ref\":\"image-662a3e4a13cb6eea1862a0560698ae63cbdc29e0-667x1000-jpg\",\"_type\":\"reference\"}}],\"isbn\":\"9780374602574\",\"legacyId\":\"5273\",\"notes\":null,\"publisher\":\"Farrar,Straus and Giroux\",\"slug\":{\"current\":\"laserwriter-ii\"},\"title\":\"LaserWriter II\"},\"className\":\"\"}]\n"])</script><script>self.__next_f.push([1,"28:[\"$\",\"$L25\",\"legacy-book-5270\",{\"book\":{\"_createdAt\":\"2020-12-10T21:53:19Z\",\"_id\":\"legacy-book-5270\",