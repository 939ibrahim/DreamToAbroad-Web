essibility%2CaccessibilityDetails%2CageRating%2CbackgroundAssetsInfo%2CbackgroundAssetsInfoWithOptional%2CcustomArtwork%2CcustomDeepLink%2CcustomIconArtwork%2CcustomPromotionalText%2CcustomScreenshotsByType%2CcustomVideoPreviewsByType%2Cdescription%2CexpectedReleaseDateDisplayFormat%2CfileSizeByDevice%2CgameDisplayName%2CiconArtwork%2CinstallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=top-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1671630889","platform":"iphone"}},"impressionMetrics":{"fields":{"id":"1671630889","name":"Weight Loss App - DayDi","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":2,"contentRating":200,"bundleId":"daydi.com"}}},{"$kind":"Lockup","adamId":"773676355","bundleId":"com.gymnotize","decorations":[],"icon":{"$kind":"Artwork","backgroundColor":{"red":0.9882352941176471,"green":0.6745098039215687,"blue":0.2549019607843137,"type":"rgb"},"textColor":{"red":0.08627450980392157,"green":0.08235294117647059,"blue":0.07450980392156863,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/04/8d/31/048d3137-7a48-dd25-c0da-56b721fd464b/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]},"title":"Gym Fitness & Workout Planner","isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"subtitle":"Progress Log for Men & Women","tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Progress Log for Men & Women","editorialTagline":"Try workouts with AR","ageRating":"4+","productDescription":"You want to reach your fitness goals faster?\nThat’s where Gymnotize and its augmented reality (AR) training tools can help.\n\nWith dozens of weight-based exercises to choose from, this is a comprehensive training app. It lets you track your repetition count, create customized workouts and graph fitness progress. But it’s the app’s use of AR to show you how to correctly lift weights that really makes it stand out.\n\nIt’s like having your own personal trainer.\n\nWHY IS GYMNOTIZE UNIQUE?\n\n• Ingenious 3D fitness animations\n   help you to adopt the correct \n   exercise technique.\n• You can see exactly which \n   muscle groups are being used\n   in which exercise.*\n\n• Many professional training plans\n   (including concepts such as: HIT, HST, DC, ...)\n   help you to make your training effectively.*\n• Of course, you can also create your\n   own exercises and training plans.*\n\n• The beautiful graphical evaluation\n   of your training successes helps to\n   analyze your strengths and weaknesses.*\n\n• You can easily create several users \n   (training partners) and simply switch\n   between them during the training.\n• Of course, you can capture separate\n   body data (such as size, weight,\n   body fat) for each user.\n\n• In addition, Gymnotize is super fast\n   and easy to use.\n\n*Will be unlocked by purchasing\n   the Pro version.\n\nTerms and conditions:\nhttps://www.iubenda.com/terms-and-conditions/66284047\n\nPrivacy policy:\nhttps://www.iubenda.com/privacy-policy/7830878","rating":4.6,"ratingCount":"3.2K","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=773676355&pricingParameters=STDQ&pg=default&appExtVrsId=889310448"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"773676355"},{"locationPosition":3,"locationType":"lockup","name":"Gym Fitness & Workout Planner","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"773676355"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"773676355","eventType":"click","targetType":"button","targetId":"773676355","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{"jet_adamId":"773676355"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"773676355","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=773676355&pricingParameters=STDQ&pg=default&appExtVrsId=889310448","vendor":"Steffen Ruppel","appName":"Gym Fitness & Workout Planner","bundleId":"com.gymnotize","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":tru