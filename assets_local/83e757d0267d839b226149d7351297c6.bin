tonist: Gym Workout Tracker","itemDescription":"Strength Log: Sets, Reps & PRs","appIcon":{"$kind":"Artwork","backgroundColor":{"red":0.18823529411764706,"green":0.18823529411764706,"blue":0.18823529411764706,"type":"rgb"},"textColor":{"red":0.7764705882352941,"green":0.7098039215686275,"blue":1,"type":"rgb"},"style":"roundedRectPrerendered","crop":"bb","contentMode":null,"imageScale":null,"template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/c5/12/18/c51218aa-39a7-729e-ff38-ea4085836511/Placeholder.mill/{w}x{h}bb-70.png","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}]}},"supportAction":{"title":"App Support","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://fitonist.com","isSensitive":false},"alwaysAllowReviews":false}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false},{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"23","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":2}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"11750257934","title":"This is a great app","date":"2024-09-22T00:26:09.000Z","dateText":"* null *","contents":"This is a great app for fitness and within a month I have lost 10lbs with this app. The only thing is right now the Ap is saying I'm not subscribed to the Al coach but I am.","rating":5,"reviewerName":"Fitmom0893","dateAuthorText":"* null * · Fitmom0893","response":{"$kind":"Response","id":"46992763","contents":"Thank you for using our app and providing this feedback, from our side we are working on resolution as it affected some of our users. We will make our best to publish update with bugfix as soon as possible, please make sure you have latest app version and don't hesitate to contact us for any concerns in the future.","date":"2024-09-25T14:20:27.000Z","dateText":"* null *"}},{"$kind":"Review","id":"10395945576","title":"The app shows blank screen after workout","date":"2023-09-22T18:58:41.000Z","dateText":"* null *","contents":"After completing 1st work out, the app shut down wouldn’t let me log back in after two days of trying to log back in and successfully on the second day my data was deleted and the screen is still blank. There’s no way for me to look at workouts, try new workouts, do anything like change profile picture great at app, Great first workOut wish I could do more.","rating":1,"reviewerName":"Jaydel500","dateAuthorText":"* null * · Jaydel500","response":{"$kind":"Response","id":"39330741","contents":"Thank you for the positive feedback about the first workout! We have identified the issue that was causing the screen to be grey. As part of the last release the bug was fixed. Please let us know if you still experience any issues. Feel free to reach out to our email with feedback and propositions - fitonist@fitonist.com Have great day, stay fit and healthy!","date":"2023-10-05T07:58:21.000Z","dateText":"* null *"}},{"$kind":"Review","id":"9266857333","title":"Amazing app!","date":"2022-11-08T04:53:04.000Z","dateText":"* null *","contents":"I have been looking for a nice gym app for year, and that exactly what I wanted! Please keep improving the app, it’s amazing!","rating":5,"reviewerName":"Stas P93","dateAuthorText":"* null * · Stas P93"},{"$kind":"Review","id":"10374569613","title":"Review","date":"2023-09-16T14:58:40.000Z","dateText":"* null *","contents":"Love this app but it completely glitches out on my during my workout and I couldn’t get back into my workout because I opened the app and it was just a white screen","rating":3,"reviewerName":"Amelie2244","dateAuthorText":"* null * · Amelie2244","response":{"$kind":"Response","id":"39330880","contents":"Hello Amelie,\n\nGreat that you’ve liked the app. We are sorry you’ve experienced this issue. We’ve identified the bug that was causing the problem to happen, and in the last release it was fixed. Please let us know if you still experience any issues at fitonist@fitonist.com \n\nHave a great day and keep working out!","date":"2023-10-05T08:02:22.000Z","dateText":"* null *"}},{"$kind":"Review","id":"10206139112","title":"Needed!","date":"2023-08-01T05:47:28.000Z","dateText":"* null *","contents":"I like this idea when you want variety in the gym","rating":5,"reviewerName":"deandruhhh","dateAuthorText":"* null * · deandruhhh","response":{"$kind":"Response","id":"38235742","contents":"We are pleased to hear that you appreciate the concept of our app for introducing variety to your gym sessions. We put a lot of thought into creating a diverse and engaging experience. Thank you for your support!","date":"2023-08-11T09:58:58.000Z","dateText":"* null *"}},{"$kind":"Review","id":"10331105346","title":"Awesome App","date":"2023-09-03T20:58:00.000Z","dateText":"* null *","contents":"Loving this app and getting fit!","rating":5,"reviewerName":"McK3nzi3Lynn","dateAuthorText":"* null * · McK3nzi3Lynn","response":{"$kind":"Response","id":"39330891","contents":"Thanks for the great feedback!","date":"2023-10-05T08:02:49.000Z","dateText":"* null *"}},{"$kind":"Review","id":"10849822761","title":"Quite ok functionality","date":"2024-01-22T04:26:54.000Z","dateText":"* null *","contents":"Nice and simple app, but would be nice to have more advanced functions.","rating":4,"reviewerName":"Niemastat","dateAuthorText":"* null * · Niemastat","response":{"$kind":"Response","id":"41482723","contents":"Hello and thank you for you feedback! Great to hear that you find the app valuable! Could you please tell more about the features you would like to see in the feedback form you can find in the app settings.\n\nThanks and have a nice day 😊","date":"2024-01-23T16:47:27.000Z","dateText":"* null *"}},{"$kind":"Review","id":"10497342078","title":"Terrible app","date":"2023-10-21T00:11:38.000Z","dateText":"* null *","contents":"I stupidly bought the subscription and was happy with it until it's most recent update. Complete trash, can't wait for the subscription to expire to be rid of it. Delete my review and I will continue to post it.","rating":1,"reviewerName":"Drea1187","dateAuthorText":"* null * · Drea1187","response":{"$kind":"Response","id":"39660534","contents":"Hello, sorry to hear you experienced some problems. Could you please tell us more what exactly you did not like and how we could improve it? Feel free to send us email to fitonist@fitonist.com\n\nStay fit,\nFitonist team ","date":"2023-10-22T14:03:39.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"background":{"type":"none"},"contentsMetadata":{"type":"none"},"isPersonalized":false,"shouldFilterApps":false,"id":"ReviewsPage.ShelfId.helpful","presentationHints":{"isSortable":true,"isSeeAllContext":true}}],"title":null,"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","trailingNavBarAction":null,"adamId":"6443644593","nextPage":{"url":"x-as3-internal:/reviews/shelf/6443644593/helpful","remainingContent":[],"nextHref":"/v1/catalog/us/apps/6443644593/reviews?l=en-US&offset=8","profile":"lockup","maxPerPage":20,"highestOrdinal":0,"metricsPageInformation":null,"metricsLocationTracker":null},"initialSortOptionIdentifier":"helpful"