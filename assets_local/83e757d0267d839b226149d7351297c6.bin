eview","date":"2023-09-16T14:58:40.000Z","dateText":"* null *","contents":"Love this app but it completely glitches out on my during my workout and I couldn’t get back into my workout because I opened the app and it was just a white screen","rating":3,"reviewerName":"Amelie2244","dateAuthorText":"* null * · Amelie2244","response":{"$kind":"Response","id":"39330880","contents":"Hello Amelie,\n\nGreat that you’ve liked the app. We are sorry you’ve experienced this issue. We’ve identified the bug that was causing the problem to happen, and in the last release it was fixed. Please let us know if you still experience any issues at fitonist@fitonist.com \n\nHave a great day and keep working out!","date":"2023-10-05T08:02:22.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"10374569613","title":"Review","date":"2023-09-16T14:58:40.000Z","dateText":"* null *","contents":"Love this app but it completely glitches out on my during my workout and I couldn’t get back into my workout because I opened the app and it was just a white screen","rating":3,"reviewerName":"Amelie2244","dateAuthorText":"* null * · Amelie2244","response":{"$kind":"Response","id":"39330880","contents":"Hello Amelie,\n\nGreat that you’ve liked the app. We are sorry you’ve experienced this issue. We’ve identified the bug that was causing the problem to happen, and in the last release it was fixed. Please let us know if you still experience any issues at fitonist@fitonist.com \n\nHave a great day and keep working out!","date":"2023-10-05T08:02:22.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched