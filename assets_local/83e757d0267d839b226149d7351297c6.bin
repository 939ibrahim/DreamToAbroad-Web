2026 06:29:38 GMT+0000 (Coordinated Universal Time)"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"Version History","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"fields":{"location":[{"locationPosition":2,"locationType":"button","name":"Version History"}],"actionType":"navigate","target":"button_See All","eventType":"click","targetType":"button","targetId":"See All","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified","shouldFlush":false}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"versionHistory","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":null,"contentType":"titledParagraph","marker":null,"items":[{"$kind":"TitledParagraph","text":"Bug fixes and performance improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.151","secondarySubtitle":"Sat Jul 18 2026 06:29:38 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"This update makes Fitonist smoother when training with Apple Watch:\n\n- Heart rate in the app: See your heart rate in Fitonist when connected to Apple Watch.\n- Watch improvements: More reliable workout metrics, tracking, and rest timer syncing.\n- Workout fixes: Fixed an issue where older unfinished workouts could stay stuck.\n- More improvements: General cleanup and stability improvements across the app.\n\nThanks for training with Fitonist! Leave us a review or reach out anytime.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.150","secondarySubtitle":"Sat Jul 11 2026 11:23:37 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"This update brings clearer workout guidance, richer workout summaries, and smoother Watch support:\n\n- Exercise instructions: Get helpful guidance for exercises right from your workout.\n- Exercise preferences: Favorite exercises you like and exclude ones you want to avoid.\n- Workout insights: Review heart rate charts after finished workouts.\n- Watch improvements: Smoother workout tracking, syncing, and rest timers.\n- More improvements: Added treadmill walking and fixed issues across workouts.\n\nThanks for training with Fitonist! Leave us a review or reach out anytime.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.149","secondarySubtitle":"Fri Jun 26 2026 06:31:14 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"This update brings more flexibility to your week plan, plus important stability improvements:\n\n- Skip Workouts: Need a day off? Skip any workout right from your week plan to keep your schedule on track.\n- Stability Improvements: Various fixes and performance enhancements for a smoother, more reliable experience.\n\nThanks for training with Fitonist! We'd love to hear your feedback — leave us a review or reach out anytime.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.148","secondarySubtitle":"Fri Jun 12 2026 06:21:43 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"This update introduces smarter muscle tracking, better workout variety, and important stability fixes:\n\n- Muscle Recovery Tracking: View muscle recovery levels directly inside the adjust muscles selector to help plan your training splits smarter.\n- Smarter Workout Rotations: Improved exercise randomization logic to ensure a better variety of routines and exercise rotation.\n- Bug Fixes & Stability: Resolved a crash in the exercise replacement flow and fixed scheduled notification icon crashes.\n\nThanks for training with Fitonist! We'd love to hear your feedback — leave us a review or reach out anytime.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.147","secondarySubtitle":"Mon Jun 08 2026 18:19:07 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"This update makes your workouts feel even better:\n\n- A fresh new look on the home screen — discover workouts and track your weekly progress with beautifully redesigned cards.\n- Quickly edit your workout and make fast adjustments on the fly — tweak sets, swap exercises, and fine-tune your session without breaking your flow.\n- Faster access to what matters mid-set: notes, history, and set styles are now just a tap away from each exercise.\n- A smoother finish to every session with refined animations and a polished progress ring.\n- Plus performance improvements and small fixes throughout the app.\n\nThanks for training with Fitonist! We'd love to hear what you think — leave us a review or reach out anytime.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.146","secondarySubtitle":"Tue Jun 02 2026 05:27:11 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"What's new in Fitonist:\n\n- Redesigned duration timer — now with a circular progress ring that's easier to read mid-set.\n- Cleaner exercise input dialog: switching between keyboard, scroll, and timer is now one tap away.\n- Bug fixes and stability improvements.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.145.0","secondarySubtitle":"Wed May 06 2026 07:39:50 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"What's new in Fitonist:\n\n- Apple Watch heart rate is now captured more reliably during workouts.\n- You can now pause a workout and come back when you're ready.\n- Progress trends now start from your week start for cleaner comparisons.\n- We also fixed bugs and polished the UI across the app.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.144.0","secondarySubtitle":"Thu Apr 30 2026 06:45:19 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"What's new in Fitonist:\n\n- The finish workout screen is now cleaner and easier to use.\n- You now get clearer per-muscle and per-side guidance during workouts.\n- Camera permission steps are easier to follow.\n- Workout records now recalculate more reliably after you save.\n- We also fixed bugs and polished the UI across the app.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.143.0","secondarySubtitle":"Tue Apr 21 2026 08:58:38 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"- New workout stats with clearer trends and per-muscle insights.\n- Added a dedicated muscle trend details screen with clearer states and actions.\n- Improved exercise history behavior for empty and zero-data charts.\n- Smoother workout panel drag and scroll interactions.\n- Visual polish across stats and finished workout cards.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.142.0","secondarySubtitle":"Wed Apr 08 2026 06:47:42 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"- New Trends dashboard for quick insights\n- Muscle Readiness to guide your training\n- Progress charts for weight & volume\n- Smart weight and rep recommendations\n- Advanced performance tracking (1RM, volume, best lifts)","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.141.0","secondarySubtitle":"Tue Mar 24 2026 08:31:20 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Discover What's New in Fitonist! \n\n- Customized Workouts: Experience personalized gym sessions tailored just for you! Our AI algorithm now crafts workouts based on your fitness goals, preferences, and progress, ensuring every rep counts towards your success. \n\nLoving our app? Remember to leave a review and let everyone know how Fitonist is helping you.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.140.0","secondarySubtitle":"Fri Mar 06 2026 20:06:11 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"- Your plans and workout history now stay in sync more reliably.\n- Workout Splits are smoother and easier to manage.\n- We fixed a bunch of bugs and improved overall app stability and performance.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.139.0","secondarySubtitle":"Mon Mar 02 2026 11:29:49 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"What’s New in Fitonist\n\n• Massive Workout Customization Upgrade\nFitonist now gives you full control over your training. Adjust reps, sets, rest timers (by load), warmups, supersets, dropsets, cardio placement, muscle focus, exercise exclusions, and more.\n\n• Split Presets by Fitonist Team\nChoose from professionally designed split templates — optimized for different goals and weekly schedules.\n\n• Create Your Own Splits\nBuild fully custom splits with multiple sessions.\n\n• Create Splits from Workouts or Muscles\nGenerate a training plan directly from selected workouts or target muscle groups — faster and more flexible than ever.\n\nPlus performance improvements and important bug fixes.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.138.0","secondarySubtitle":"Fri Feb 20 2026 10:40:41 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Discover What's New in Fitonist! \n\n- Customized Workouts: Experience personalized gym sessions tailored just for you! Our AI algorithm now crafts workouts based on your fitness goals, preferences, and progress, ensuring every rep counts towards your success. \n\nLoving our app? Remember to leave a review and let everyone know how Fitonist is helping you.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.137","secondarySubtitle":"Fri Feb 06 2026 16:02:45 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Discover What's New in Fitonist! \n\n- Customized Workouts: Experience personalized gym sessions tailored just for you! Our AI algorithm now crafts workouts based on your fitness goals, preferences, and progress, ensuring every rep counts towards your success. \n\nLoving our app? Remember to leave a review and let everyone know how Fitonist is helping you.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.136","secondarySubtitle":"Thu Jan 15 2026 10:56:19 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Discover What's New in Fitonist! \n\n- Customized Workouts: Experience personalized gym sessions tailored just for you! Our AI algorithm now crafts workouts based on your fitness goals, preferences, and progress, ensuring every rep counts towards your success. \n\nLoving our app? Remember to leave a review and let everyone know how Fitonist is helping you.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.135","secondarySubtitle":"Wed Jan 07 2026 15:52:45 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Discover What's New in Fitonist! \n\n- Customized Workouts: Experience personalized gym sessions tailored just for you! Our AI algorithm now crafts workouts based on your fitness goals, preferences, and progress, ensuring every rep counts towards your success. \n\nLoving our app? Remember to leave a review and let everyone know how Fitonist is helping you.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.134","secondarySubtitle":"Mon Dec 22 2025 20:29:42 GMT+0000 (Coordinated Universal Time)"},{"$kind":"TitledParagraph","text":"Discover What's New in Fitonist! \n\n- Customized Workouts: Experience personalized gym sessions tailored just for you! Our AI algorithm now crafts workouts based on your fitness goals, preferences, and progress, ensuring every rep counts towards your success. \n\nLoving our app? Remember to leave a review and let everyone know how Fitonist is helping you.","style":"detail","wantsCollapsedNewlines":true,"primarySubtitle":"1.133","secondarySubtitle":"Mon Dec 08 2025 16:26:25 GMT+0000 (Coordinated Universal Time)"},{"$kind":"Ti